{
  "name": "voice-definition-agent",
  "version": "1.0.0",
  "description": "Hands-free dictionary assistant powered by ElevenLabs Conversational AI",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "build": "esbuild public/client.src.js --bundle --outfile=public/client.js --platform=browser --target=es2020",
    "postinstall": "npm run build",
    "test": "jest --forceExit",
    "create-agent": "node scripts/createAgent.js"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.0.0",
    "@elevenlabs/elevenlabs-js": "^2.0.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "fast-check": "^3.0.0",
    "jest": "^29.0.0",
    "supertest": "^6.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
